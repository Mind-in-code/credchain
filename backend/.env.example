# Copy this file to .env and fill in the values.
# .env is in .gitignore. Never commit it and never paste these values in chat.
# Nothing here is needed for the local Hardhat network. It is only for Sepolia.

# Alchemy or Infura HTTPS endpoint for Sepolia.
SEPOLIA_RPC_URL=

# Private key of the ADMIN test wallet only. Use a throwaway wallet.
# Never use a wallet that holds real money.
PRIVATE_KEY=

# From etherscan.io, used by `npx hardhat verify`.
ETHERSCAN_API_KEY=
