# Copy this file to .env and adjust. .env is gitignored, never commit it.

# true  = mock data, demo role switcher visible, no wallet needed
# false = real contract calls through ethers
VITE_DEMO_MODE=false

# Local Hardhat chain
VITE_CHAIN_ID=31337
VITE_RPC_URL=http://127.0.0.1:8545
VITE_DEPLOY_BLOCK=0

# Pinata JWT scoped to pinJSONToIPFS only.
# Leave empty to store metadata inline as a data URI instead.
VITE_PINATA_JWT=

# Leave empty for the local chain, it has no block explorer.
VITE_EXPLORER_URL=

# For Sepolia instead:
#   VITE_CHAIN_ID=11155111
#   VITE_RPC_URL=<your Alchemy or Infura Sepolia url>
#   VITE_EXPLORER_URL=https://sepolia.etherscan.io
